# Copy to .env.local (gitignored) for local development; in Vercel set them as environment
# variables. Never commit real values (tech_standards §10).

# Shared access key the phone sends in the x-app-key header (ADR 003). Use a long random value.
APP_ACCESS_KEY=

# The whole service-account key JSON, on one line (ADR 002). The `fitness` folder is shared with
# its client_email, read-only for feature fitness-coach/001.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Id of the `fitness` folder in Google Drive (the last part of its URL).
GOOGLE_DRIVE_FOLDER_ID=
