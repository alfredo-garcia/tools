project_id = "your-gcp-project-id"
region     = "europe-west1"

environment = "development"

artifact_registry_repository_id = "tools-n8n"
n8n_service_name                = "tools-n8n"
n8n_runtime_sa_account_id       = "tools-n8n-dev-runtime"
# Optional: SA used by GitHub Actions (secret GCP_SA_KEY). Terraform grants iam.serviceAccountUser on the runtime SA.
# github_actions_deploy_sa_email = "github-actions-deploy@your-gcp-project-id.iam.gserviceaccount.com"

# First apply: official image. After CI pushes to Artifact Registry, set to:
# n8n_image = "europe-west1-docker.pkg.dev/your-gcp-project-id/tools-n8n/n8n:latest"
# Cloud Run only accepts docker.io / Artifact Registry / gcr.io (not docker.n8n.io).
n8n_image = "docker.io/n8nio/n8n:latest"

n8n_port                  = 5678
n8n_cpu                   = "1"
n8n_memory                = "1Gi"
n8n_min_instances         = 0
n8n_max_instances         = 2
n8n_timeout_seconds       = 900
n8n_allow_unauthenticated = true
n8n_generic_timezone      = "Europe/Madrid"

# Copy terraform output n8n_service_url after first deploy. Sets WEBHOOK_URL + N8N_EDITOR_BASE_URL (fixes localhost / Offline in the browser).
# n8n_public_url = "https://tools-n8n-xxxxx-northamerica-south1.run.app"

neon_api_key        = "napi_xxxxxxxx"
neon_org_id         = "org-xxxxxxxx"
neon_project_name   = "tools-n8n-development"
neon_branch_name    = "development"
neon_database_name  = "n8n"
neon_role_name      = "n8n_app"
# Same region for project + endpoint (see Neon console). Changing this after create may recreate the project.
neon_region_id      = "aws-eu-central-1"
neon_pooler_enabled = true
# neon_connection_query_params = "channel_binding=require"

manage_neon = true

# When manage_neon is false, set external_postgres_* and omit Neon variables above.
# external_postgres_host     = "ep-xxx.region.aws.neon.tech"
# external_postgres_port     = "5432"
# external_postgres_database = "n8n"
# external_postgres_user     = "n8n_app"
# external_postgres_password = "secret"
